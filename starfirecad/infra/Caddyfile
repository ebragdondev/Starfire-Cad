{$DOMAIN} {
  encode zstd gzip
  @api path /api* /metrics /health
  handle @api {
    reverse_proxy api:4000 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
    }
  }
  handle {
    reverse_proxy web:3000 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
    }
  }
  log {
    output stdout
    format json
  }
}