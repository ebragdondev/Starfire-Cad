generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTHENTICATION & USERS ============
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  username          String    @unique
  password          String
  firstName         String
  lastName          String
  phoneNumber       String?
  avatar            String?
  emailVerified     Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  lastLogin         DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  globalRole        GlobalRole?
  communityMembers  CommunityMember[]
  dispatchSessions  DispatchSession[]
  calls             Call[]
  units             Unit[]
  messages          Message[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  layouts           UILayout[]
}

model GlobalRole {
  id          String   @id @default(uuid())
  userId      String   @unique
  role        String   // superadmin, admin, support
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ MULTI-TENANCY ============
model Community {
  id                  String    @id @default(uuid())
  name                String
  slug                String    @unique
  description         String?
  logo                String?
  website             String?
  discordWebhook      String?
  timezone            String    @default("UTC")
  isActive            Boolean   @default(true)
  subscriptionPlan    String    @default("basic") // basic, professional, enterprise
  subscriptionStatus  String    @default("active") // active, cancelled, suspended
  subscriptionExpiry  DateTime?
  stripeCustomerId    String?   @unique
  stripeSubscriptionId String?
  maxUsers            Int       @default(10)
  maxUnits            Int       @default(20)
  features            Json      @default("{}")
  settings            Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  members             CommunityMember[]
  departments         Department[]
  calls               Call[]
  units               Unit[]
  citizens            Citizen[]
  vehicles            Vehicle[]
  weapons             Weapon[]
  licenses            License[]
  warrants            Warrant[]
  bolos               BOLO[]
  incidents           Incident[]
  reports             Report[]
  codes               StatusCode[]
  channels            RadioChannel[]
  webhooks            Webhook[]
  customFields        CustomField[]
  templates           Template[]
  auditLogs           AuditLog[]
}

model CommunityMember {
  id               String   @id @default(uuid())
  userId           String
  communityId      String
  role             String   // owner, admin, supervisor, dispatcher, officer, ems, fire, civilian
  departmentId     String?
  badgeNumber      String?
  callSign         String?
  rank             String?
  permissions      Json     @default("[]")
  isActive         Boolean  @default(true)
  isPrimary        Boolean  @default(false)
  joinedAt         DateTime @default(now())
  lastActiveAt     DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  community  Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([userId, communityId])
}

// ============ DEPARTMENTS & UNITS ============
model Department {
  id          String   @id @default(uuid())
  communityId String
  name        String
  abbreviation String
  type        String   // police, fire, ems, dispatch
  color       String   @default("#3B82F6")
  isActive    Boolean  @default(true)
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members   CommunityMember[]
  units     Unit[]
  ranks     Rank[]
}

model Rank {
  id           String   @id @default(uuid())
  departmentId String
  name         String
  abbreviation String
  level        Int
  permissions  Json     @default("[]")
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model Unit {
  id              String    @id @default(uuid())
  communityId     String
  departmentId    String?
  userId          String
  callSign        String
  status          String    @default("10-7") // 10-7 (off duty), 10-8 (available), 10-6 (busy), 10-23 (arrived), etc.
  location        Json?     // {lat, lng, heading, speed}
  vehicleId       String?
  isPanic         Boolean   @default(false)
  isOnline        Boolean   @default(false)
  lastStatusChange DateTime @default(now())
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime @updatedAt

  community    Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  callUnits    CallUnit[]
  trafficStops TrafficStop[]
}

// ============ DISPATCH & CALLS ============
model Call {
  id              String   @id @default(uuid())
  communityId     String
  callNumber      String
  type            String   // 911, non-emergency, panic, silent
  priority        String   // low, medium, high, critical
  status          String   // pending, active, dispatched, en_route, on_scene, completed, cancelled
  nature          String
  location        String
  coordinates     Json?    // {lat, lng}
  description     String?
  callerName      String?
  callerPhone     String?
  callerLocation  String?
  dispatcherId    String?
  primaryUnitId   String?
  createdAt       DateTime @default(now())
  dispatchedAt    DateTime?
  arrivedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt

  community  Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  dispatcher User?      @relation(fields: [dispatcherId], references: [id], onDelete: SetNull)
  units      CallUnit[]
  notes      CallNote[]
  events     CallEvent[]

  @@index([communityId, status])
  @@index([callNumber])
}

model CallUnit {
  id         String   @id @default(uuid())
  callId     String
  unitId     String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())
  arrivedAt  DateTime?
  clearedAt  DateTime?

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([callId, unitId])
}

model CallNote {
  id        String   @id @default(uuid())
  callId    String
  content   String
  authorId  String
  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
}

model CallEvent {
  id        String   @id @default(uuid())
  callId    String
  type      String   // created, dispatched, unit_assigned, unit_arrived, status_changed, completed
  data      Json
  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
}

model DispatchSession {
  id        String   @id @default(uuid())
  userId    String
  startTime DateTime @default(now())
  endTime   DateTime?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ MDT - CITIZENS & RECORDS ============
model Citizen {
  id              String   @id @default(uuid())
  communityId     String
  firstName       String
  lastName        String
  middleName      String?
  dateOfBirth     DateTime
  gender          String
  ethnicity       String?
  height          String?
  weight          String?
  eyeColor        String?
  hairColor       String?
  address         String
  city            String
  state           String
  zipCode         String
  phoneNumber     String?
  occupation      String?
  employer        String?
  photo           String?
  fingerprints    String?
  dna             String?
  flags           String[] @default([])
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  community     Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  licenses      License[]
  vehicles      Vehicle[]
  weapons       Weapon[]
  warrants      Warrant[]
  arrests       Arrest[]
  citations     Citation[]
  warnings      Warning[]
  incidents     IncidentPerson[]
  trafficStops  TrafficStop[]

  @@index([communityId, firstName, lastName])
}

model Vehicle {
  id              String   @id @default(uuid())
  communityId     String
  ownerId         String?
  plate           String
  vin             String?
  make            String
  model           String
  year            Int
  color           String
  type            String   // car, truck, motorcycle, etc.
  isStolen        Boolean  @default(false)
  isWanted        Boolean  @default(false)
  insuranceStatus String?
  insuranceExpiry DateTime?
  registrationStatus String?
  registrationExpiry DateTime?
  flags           String[] @default([])
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  community    Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  owner        Citizen?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  units        Unit[]
  trafficStops TrafficStop[]
  incidents    IncidentVehicle[]

  @@index([communityId, plate])
  @@index([vin])
}

model Weapon {
  id               String   @id @default(uuid())
  communityId      String
  ownerId          String?
  type             String   // handgun, rifle, shotgun, etc.
  make             String
  model            String
  caliber          String
  serialNumber     String   @unique
  registrationNumber String?
  registrationDate DateTime?
  registrationExpiry DateTime?
  isStolen         Boolean  @default(false)
  flags            String[] @default([])
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  owner     Citizen?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([communityId, serialNumber])
}

model License {
  id          String   @id @default(uuid())
  communityId String
  citizenId   String
  type        String   // driver, ccw, pilot, hunting, fishing, etc.
  number      String
  issuedDate  DateTime
  expiryDate  DateTime
  status      String   // valid, suspended, revoked, expired
  restrictions String[] @default([])
  endorsements String[] @default([])
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  citizen   Citizen   @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@unique([communityId, number])
}

// ============ WARRANTS & BOLOS ============
model Warrant {
  id          String   @id @default(uuid())
  communityId String
  citizenId   String
  warrantNumber String
  type        String   // arrest, bench, search
  status      String   // active, served, cancelled
  charges     String[]
  issuedDate  DateTime
  issuedBy    String
  validUntil  DateTime?
  bail        Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  citizen   Citizen   @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([communityId, status])
}

model BOLO {
  id          String   @id @default(uuid())
  communityId String
  type        String   // person, vehicle, other
  status      String   // active, located, cancelled
  priority    String   // low, medium, high, critical
  description String
  lastSeen    String?
  reason      String
  issuedBy    String
  issuedAt    DateTime @default(now())
  expiresAt   DateTime?
  locatedAt   DateTime?
  notes       String?
  images      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, status])
}

// ============ INCIDENTS & REPORTS ============
model Incident {
  id              String   @id @default(uuid())
  communityId     String
  incidentNumber  String
  type            String
  status          String   // open, under_investigation, closed
  priority        String
  location        String
  coordinates     Json?
  description     String
  occurredAt      DateTime
  reportedAt      DateTime @default(now())
  respondingUnits String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  community Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  persons   IncidentPerson[]
  vehicles  IncidentVehicle[]
  evidence  Evidence[]
  reports   Report[]

  @@index([communityId, status])
}

model IncidentPerson {
  id         String @id @default(uuid())
  incidentId String
  citizenId  String
  role       String // suspect, victim, witness, other

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  citizen  Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@unique([incidentId, citizenId])
}

model IncidentVehicle {
  id         String @id @default(uuid())
  incidentId String
  vehicleId  String
  role       String // involved, stolen, evidence

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([incidentId, vehicleId])
}

model Evidence {
  id          String   @id @default(uuid())
  incidentId  String
  type        String   // physical, digital, document, photo, video
  description String
  location    String?
  collectedBy String
  collectedAt DateTime
  chainOfCustody Json  @default("[]")
  files       String[] @default([])
  createdAt   DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(uuid())
  communityId String
  incidentId  String?
  reportNumber String
  type        String   // incident, arrest, accident, use_of_force
  title       String
  content     String
  authorId    String
  status      String   // draft, submitted, approved, rejected
  submittedAt DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  attachments String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  incident  Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([communityId, status])
}

// ============ TRAFFIC STOPS & CITATIONS ============
model TrafficStop {
  id          String   @id @default(uuid())
  unitId      String
  citizenId   String?
  vehicleId   String?
  location    String
  reason      String
  outcome     String   // warning, citation, arrest, none
  startTime   DateTime @default(now())
  endTime     DateTime?
  notes       String?

  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  citizen   Citizen?  @relation(fields: [citizenId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  citations Citation[]
  warnings  Warning[]
  arrests   Arrest[]
}

model Citation {
  id             String   @id @default(uuid())
  citizenId      String
  trafficStopId  String?
  citationNumber String
  violations     String[]
  fineAmount     Float
  courtDate      DateTime?
  isPaid         Boolean  @default(false)
  paidAt         DateTime?
  issuedBy       String
  issuedAt       DateTime @default(now())
  notes          String?

  citizen      Citizen      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  trafficStop  TrafficStop? @relation(fields: [trafficStopId], references: [id], onDelete: SetNull)
}

model Warning {
  id            String   @id @default(uuid())
  citizenId     String
  trafficStopId String?
  reason        String
  issuedBy      String
  issuedAt      DateTime @default(now())
  notes         String?

  citizen     Citizen      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  trafficStop TrafficStop? @relation(fields: [trafficStopId], references: [id], onDelete: SetNull)
}

model Arrest {
  id            String   @id @default(uuid())
  citizenId     String
  trafficStopId String?
  arrestNumber  String
  charges       String[]
  location      String
  arrestedBy    String
  arrestedAt    DateTime @default(now())
  bookingNumber String?
  bailAmount    Float?
  courtDate     DateTime?
  notes         String?

  citizen     Citizen      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  trafficStop TrafficStop? @relation(fields: [trafficStopId], references: [id], onDelete: SetNull)
}

// ============ COMMUNICATION ============
model RadioChannel {
  id          String   @id @default(uuid())
  communityId String
  name        String
  frequency   String
  type        String   // main, tac, emergency
  isEncrypted Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String?
  channelId   String?
  content     String
  type        String   // text, system, alert
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // call, panic, system, message
  title     String
  content   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ CONFIGURATION ============
model StatusCode {
  id          String   @id @default(uuid())
  communityId String
  code        String
  meaning     String
  type        String   // status, situation, common
  color       String?
  shouldPanic Boolean  @default(false)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, code])
}

model Template {
  id          String   @id @default(uuid())
  communityId String
  name        String
  type        String   // report, citation, warrant, etc.
  content     Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model CustomField {
  id          String   @id @default(uuid())
  communityId String
  entityType  String   // citizen, vehicle, call, etc.
  fieldName   String
  fieldType   String   // text, number, date, select, etc.
  options     Json?
  isRequired  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model Webhook {
  id          String   @id @default(uuid())
  communityId String
  name        String
  url         String
  events      String[] // call_created, unit_panic, etc.
  isActive    Boolean  @default(true)
  secret      String?
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

// ============ UI CUSTOMIZATION ============
model UILayout {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String   // dispatch, mdt, admin
  layout    Json     // Grid layout configuration
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ AUDIT & LOGGING ============
model AuditLog {
  id          String   @id @default(uuid())
  communityId String?
  userId      String
  action      String
  entityType  String
  entityId    String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@index([userId, createdAt])
}