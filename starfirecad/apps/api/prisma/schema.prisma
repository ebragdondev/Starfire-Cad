generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  USER
  GLOBAL_ADMIN
}

enum CommunityRole {
  MEMBER
  COMMUNITY_MANAGER
  COMMUNITY_ADMIN
  COMMUNITY_OWNER
}

model User {
  id           String      @id @default(uuid())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  email        String      @unique
  username     String      @unique
  passwordHash String
  globalRole   GlobalRole  @default(USER)

  createdCommunities Community[] @relation("CreatedCommunities")
  memberships Membership[]
  preferences UserPreference?
}

model Community {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  name      String      @unique
  slug      String      @unique
  settings  Json

  createdBy     User   @relation("CreatedCommunities", fields: [createdById], references: [id])
  createdById   String
  members       Membership[]
  subscription  CommunitySubscription?
}

model Membership {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  role        CommunityRole @default(MEMBER)

  user        User          @relation(fields: [userId], references: [id])
  userId      String
  community   Community     @relation(fields: [communityId], references: [id])
  communityId String

  @@unique([userId, communityId], name: "userId_communityId")
}

model UserPreference {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  uiLayout  Json

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model CommunitySubscription {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  plan               String
  status             String
  stripeCustomerId   String?
  stripeSubscriptionId String?

  community   Community @relation(fields: [communityId], references: [id])
  communityId String   @unique
}